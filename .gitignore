# dependencies
node_modules/
.pnpm-store/

# build output
dist/
*.tsbuildinfo

# local env / secrets (highest-value secrets in the system — never commit)
.env
.env.local
*.local

# Argus runtime data (SQLite cache + sacred native tables live outside git)
data/
*.db
*.sqlite
*.sqlite-shm
*.sqlite-wal

# logs
*.log

# OS
.DS_Store

# raw prompt journal is a build artifact captured by the UserPromptSubmit hook;
# the distilled PROMPTS.md is committed, the raw jsonl is not
prompts-raw.jsonl

# editor
.vscode/
.idea/

# Claude Code session state (harness-managed, not source)
.claude/.session-state/

# Managed local n8n instances (prod + staging data folders + logs)
.n8n-instances/

# Internal planning notes and the build journal — kept locally, not published.
# (The standing rules in CLAUDE.md, the reusable skills and the per-subsystem
# specs under .agents/ ARE published; they document how this project is built.)
PROMPTS.md
EXPERIMENT.md
DEMOS.md
docs/PLAN.md
docs/DECISIONS.md
docs/DEV-STRATEGY.md
docs/M0-KICKOFF.md
docs/STRATEGY-KICKOFF.md

# Local Claude Code runtime config (machine-specific; skills live in .agents/).
.claude/
