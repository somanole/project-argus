{
  "name": "project-argus",
  "version": "0.0.0",
  "private": true,
  "description": "Project Argus — fleet-wide governance and accountability layer for n8n.",
  "type": "module",
  "engines": {
    "node": ">=22.22",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.23.0",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "dev": "pnpm --parallel -r dev",
    "dev:server": "pnpm --filter @argus/server dev",
    "dev:web": "pnpm --filter @argus/web dev",
    "probe:n8n": "node scripts/probe-n8n.mjs",
    "probe:catalog": "node scripts/probe-catalog.mjs",
    "probe:llm": "node --env-file=.env scripts/probe-llm.mjs",
    "probe:freshness": "node scripts/probe-freshness.mjs",
    "eval": "tsx scripts/eval/run.ts",
    "eval:chat": "tsx scripts/eval/chat/run.ts",
    "n8n:up": "node scripts/n8n-up.mjs",
    "seed": "node scripts/seed.mjs",
    "seed:unlock": "node scripts/seed-unlock.mjs",
    "demo:serve": "node --env-file=.env apps/server/dist/index.js",
    "demo:deploy": "pnpm build && launchctl kickstart -k gui/$(id -u)/com.argus.demo && echo '✔ deployed to https://stelos-mac-mini.tail290124.ts.net:8443 — reviewers reload the page'",
    "gen:manifest": "node scripts/gen-manifest.mjs",
    "corpus:fetch": "node scripts/fetch-corpus.mjs",
    "corpus:check": "node scripts/corpus-check.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "better-sqlite3": "^11.7.0",
    "eslint": "^9.17.0",
    "eslint-plugin-vue": "^9.32.0",
    "globals": "^15.14.0",
    "playwright-core": "^1.61.1",
    "tsx": "^4.23.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "@parcel/watcher",
      "vue-demi"
    ]
  }
}
